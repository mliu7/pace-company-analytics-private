# Shared deployment. Fill these values on the server; never commit its .env.
PCA_DEBUG=0
PCA_AUTH_MODE=sso
PCA_SECRET_KEY=
PCA_ALLOWED_HOSTS=analytics.example.invalid
PCA_DB_HOST=127.0.0.1
PCA_DB_PORT=5432
PCA_DB_NAME=pace_company_analytics
PCA_DB_USER=pca_app
PCA_DB_PASSWORD=
PCA_APP_SUPPORT_DIR=/srv/pca/files
PCA_BANK_STATEMENTS_DIR=/srv/pca/files/bank
PCA_REPORT_FILES_DIR=/srv/pca/files/reports
PCA_SHARE_ROOT=/mnt/projects
# Machine-local mount (Mac example: /Volumes/projects). Never store this prefix in file paths.
# For document reads without an OS mount, choose smb and a protected JSON credentials file
# containing username/password. Indexing still requires the mounted share.
PCA_SHARE_DOCUMENT_TRANSPORT=mount
PCA_SHARE_UNC_ROOT=\\PACE-FPS3\projects
PCA_SHARE_CREDENTIALS_FILE=
# Optional absolute path; otherwise libreoffice/soffice is discovered on PATH.
PCA_LIBREOFFICE=
# Entra Web redirect URI: https://<PCA_ALLOWED_HOSTS>/oidc/callback/
# Application (client) ID, client secret VALUE, and Directory (tenant) ID.
PCA_OIDC_CLIENT_ID=
PCA_OIDC_CLIENT_SECRET=
PCA_OIDC_TENANT_ID=
PTT_SERVER_IP=
PTT_SERVER_PORT=5432
PTT_SERVER_DATABASE=
PTT_SERVER_USERNAME=
PTT_SERVER_PASSWORD=
SQL_SERVER_IP=
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=
SQL_SERVER_USERNAME=
SQL_SERVER_PASSWORD=
